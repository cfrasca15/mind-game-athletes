# Copy to docker.env on the server and fill in.

# Inside the container's persisted volume. Leave as is.
DATABASE_URL="file:/app/data/prod.db"

# Long random string, e.g. the output of:  openssl rand -hex 32
SESSION_SECRET=""

# Comma-separated host:port entries the app is reached through, e.g.
# "your-server.tailXXXX.ts.net:3001,192.168.1.50:3001". A missing entry makes
# every save button silently do nothing from that address (Server Action CSRF
# protection in Next.js).
ALLOWED_ORIGINS=""

# "true" only once served over real HTTPS via a reverse proxy.
COOKIE_SECURE="false"

# Optional: lets her connect Google Calendar by signing in (Settings, Connect
# Google Calendar). The same three names medicare-crm uses, and the two CRMs
# can share one Google Cloud OAuth client. The redirect address is this
# server as you type it in the browser, plus /api/google/callback, and must
# also be listed on the OAuth client as an authorized redirect URI. Google
# needs a hostname here (a Tailscale name works, a bare IP does not).
# Steps: docs/GOOGLE-CALENDAR.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://your-server.tailXXXX.ts.net:3001/api/google/callback"

TZ="America/Los_Angeles"
